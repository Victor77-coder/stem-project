# Copie para .env e preencha. O .env não vai para o git.

# Django
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=0
# "api" é o nome do serviço na rede do compose; os coletores enviam a carga para http://api:8000.
ALLOWED_HOSTS=localhost,127.0.0.1,api
# Painel (Vite) e Expo web. O app nativo não passa por CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081

# Postgres (o compose monta DATABASE_URL a partir destes valores)
POSTGRES_USER=stem
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=stem

# Redis é cache descartável; sem ele a API continua respondendo pelo Postgres.
REDIS_URL=redis://cache:6379/0

# Coletas (Prefect + Celery). Gere valores longos e aleatórios.
# Token que os coletores usam em POST /api/internal/ingest/.
INGEST_API_TOKEN=troque-por-um-token-longo
# Login da UI do Prefect (usuario:senha).
PREFECT_AUTH=prefect:troque-esta-senha
PREFECT_DB_PASSWORD=troque-esta-senha
# 1 publica direto o que a coleta do CNES trouxer; 0 deixa como rascunho para aprovação no painel.
CNES_AUTO_PUBLISH=1
# 1 publica direto as novidades coletadas dos portais (sem validação clínica); 0 deixa como rascunho para aprovação no painel.
NOVIDADES_AUTO_PUBLISH=1
# Fila do Celery (serviço broker do compose; não use o Redis de cache).
CELERY_BROKER_URL=redis://broker:6379/0

# Portas locais do compose.override.yaml (mude se já estiverem em uso)
STEM_DB_PORT=5432
STEM_REDIS_PORT=6380
STEM_MAILPIT_PORT=8025
STEM_PREFECT_PORT=4200

# Avisos (RF10): endereço público da API, usado no link "parar de receber" dos e-mails.
PUBLIC_API_URL=http://localhost:8000
# Só se o projeto no EAS ativar "Enhanced Security for Push Notifications" (ver docs/notificacoes.md).
EXPO_ACCESS_TOKEN=

# E-mail (código de recuperação de senha, confirmação de e-mail, avisos aos participantes e à equipe)
# Produção: Brevo, plano grátis (ver docs/notificacoes.md). EMAIL_HOST=smtp-relay.brevo.com,
# EMAIL_HOST_USER = login SMTP e EMAIL_HOST_PASSWORD = chave SMTP, ambos em "SMTP & API" no Brevo.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
# No Brevo, o remetente precisa estar verificado (endereço ou domínio com SPF e DKIM).
DEFAULT_FROM_EMAIL=STEM Project <nao-responda@stem.local>
# Cota diária do provedor (Brevo grátis: 300, somando códigos e avisos). 0 = sem limite.
EMAIL_DAILY_LIMIT=0
# Quanto da cota fica guardado para os códigos de 6 dígitos; os avisos usam o resto.
EMAIL_DAILY_RESERVE=50
# Só em desenvolvimento: sem estas duas, o compose.override manda o e-mail para o Mailpit.
# Para testar o Brevo de verdade na sua máquina: STEM_DEV_EMAIL_HOST=smtp-relay.brevo.com e STEM_DEV_EMAIL_PORT=587.
STEM_DEV_EMAIL_HOST=
STEM_DEV_EMAIL_PORT=
# Janela de envio de push e e-mail (horário de Brasília). 0-24 desliga a janela, só para testes locais.
NOTIFY_HOURS=8-21
