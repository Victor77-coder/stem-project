# Copie para .env e preencha. O .env não vai para o git.

# Django
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=0
# "api" é o nome do serviço na rede do compose; os coletores enviam a carga para http://api:8000.
ALLOWED_HOSTS=localhost,127.0.0.1,api
# Painel (Vite) e Expo web. O app nativo não passa por CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081

# Postgres (o compose monta DATABASE_URL a partir destes valores)
POSTGRES_USER=stem
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=stem

# Redis é cache descartável; sem ele a API continua respondendo pelo Postgres.
REDIS_URL=redis://cache:6379/0

# Coletas (Prefect + Celery). Gere valores longos e aleatórios.
# Token que os coletores usam em POST /api/internal/ingest/.
INGEST_API_TOKEN=troque-por-um-token-longo
# Login da UI do Prefect (usuario:senha).
PREFECT_AUTH=prefect:troque-esta-senha
PREFECT_DB_PASSWORD=troque-esta-senha
# 1 publica direto o que a coleta do CNES trouxer; 0 deixa como rascunho para aprovação no painel.
CNES_AUTO_PUBLISH=1
# Fila do Celery (serviço broker do compose; não use o Redis de cache).
CELERY_BROKER_URL=redis://broker:6379/0

# Portas locais do compose.override.yaml (mude se já estiverem em uso)
STEM_DB_PORT=5432
STEM_REDIS_PORT=6380
STEM_MAILPIT_PORT=8025
STEM_PREFECT_PORT=4200

# E-mail (código de recuperação de senha e avisos à equipe)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=STEM Project <nao-responda@stem.local>
